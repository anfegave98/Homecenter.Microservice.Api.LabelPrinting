# Plantilla de variables de entorno del Web Service en Render.
# Copia este archivo, reemplaza los valores y cargalos en el panel de Render.
# NUNCA versiones el archivo con valores reales: .env esta en .gitignore.
#
# Genera un juego nuevo de claves con:
#   node -e "const c=require('crypto');console.log(c.randomBytes(64).toString('base64'));console.log(c.randomBytes(32).toString('base64'))"
#
# Formatos exigidos por SecretsValidator (el servicio no arranca si no se cumplen):
#   Jwt__SecretKey    texto de al menos 32 bytes UTF-8
#   Encryption__Key   Base64 que decodifica a exactamente 32 bytes (AES-256)

ASPNETCORE_ENVIRONMENT=Production

# Render la inyecta desde la base de datos gestionada (fromDatabase en render.yaml).
# Solo se define a mano si se apunta a un Postgres externo.
ConnectionStrings__DefaultConnection=

Jwt__Issuer=Homecenter.LabelPrinting
Jwt__Audience=homecenter-labelprinting-site
Jwt__SecretKey=
Jwt__ExpirationMinutes=60

Encryption__Enabled=true
Encryption__Algorithm=AES
Encryption__Key=

# Origen del frontend publicado en Cloudflare Pages. Sin esto el navegador
# bloquea toda llamada al API.
Cors__AllowedOrigins__0=https://homecenter-labelprinting-site.pages.dev

# Se deja encendido en la entrega para que el evaluador pueda probar la API.
Swagger__Enabled=true
